# Copy to .env and fill in. Both keys are free and issued instantly.
# Census Data API (ACS + County Business Patterns): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# FBI Crime Data Explorer uses an api.data.gov key: https://api.data.gov/signup/
FBI_API_KEY=DEMO_KEY
# Requests per hour to the FBI API (api.data.gov default allowance is 1,000/hour per key)
FBI_REQUESTS_PER_HOUR=900
# City universe: incorporated places with at least this many residents in 2020
CRIMECAST_MIN_POP=100000
